# Salin file ini menjadi `.env` lalu isi nilainya: cp .env.example .env

PORT=
NODE_ENV=
DEV_MODE=

# Database MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# JWT & Manager Auth (Ganti dengan string acak panjang di production)
JWT_SECRET=
JWT_EXPIRES=
ADMIN_SECRET=

# Google Gemini AI API Key
GEMINI_API_KEY=

# Ganti FCM Legacy dengan Service Account V1
GOOGLE_APPLICATION_CREDENTIALS=

# Fonnte (WhatsApp gateway) — https://fonnte.com
FONNTE_TOKEN=

# Midtrans Sandbox — Server Key
MIDTRANS_SERVER_KEY=

# Mobile App URL (Redirect Midtrans Finish Callback)
MOBILE_APP_URL=https://puthu-lanang-mobile.vercel.app

# Backend Public URL & Allowed CORS Origins (Pisahkan koma jika lebih dari satu)
BACKEND_URL=https://puthulanangbackend-production.up.railway.app
CORS_ORIGIN=https://puthu-lanang-frontend-admin.vercel.app,https://puthu-lanang-mobile.vercel.app,http://localhost:3000
