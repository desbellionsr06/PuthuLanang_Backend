# Salin file ini menjadi `.env` lalu isi nilainya: cp .env.example .env

PORT=5000
NODE_ENV=development
DEV_MODE=true

# Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=puthu_lanang_db

# JWT & Manager Auth (Ganti dengan string acak panjang di production)
JWT_SECRET=ganti_dengan_secret_jwt_panjang_yang_aman
JWT_EXPIRES=30d
ADMIN_SECRET=puthu-admin-2026

# Google Gemini AI API Key
GEMINI_API_KEY=isi_api_key_gemini_anda

# Firebase Cloud Messaging (Push Notification ke Flutter Mobile)
FCM_SERVER_KEY=isi_fcm_server_key_anda

# Fonnte (WhatsApp gateway) — https://fonnte.com
FONNTE_TOKEN=isi_token_fonnte_anda

# Midtrans Sandbox — Server Key
MIDTRANS_SERVER_KEY=isi_server_key_midtrans_anda
