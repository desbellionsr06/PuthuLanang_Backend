# Salin file ini menjadi `.env` lalu isi nilainya: cp .env.example .env

PORT=
NODE_ENV=
DEV_MODE=

# Database MySQL
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# JWT & Manager Auth (Ganti dengan string acak panjang di production)
JWT_SECRET=
JWT_EXPIRES=
ADMIN_SECRET=

# Google Gemini AI API Key
GEMINI_API_KEY=

# Ganti FCM Legacy dengan Service Account V1
GOOGLE_APPLICATION_CREDENTIALS=

# Fonnte (WhatsApp gateway) — https://fonnte.com
FONNTE_TOKEN=

# Midtrans Sandbox — Server Key
MIDTRANS_SERVER_KEY=
